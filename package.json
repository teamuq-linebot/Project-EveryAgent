{
  "name": "teamuq-electron",
  "version": "0.1.0",
  "description": "teamuq desktop app — Electron + React + TypeScript",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:build": "npm run build && playwright test",
    "rebuild:node": "npm rebuild better-sqlite3",
    "rebuild:electron": "electron-builder install-app-deps",
    "rebuild:test-abi": "node .claude/scripts/rebuild-test-abi.mjs",
    "typecheck": "tsc --build tsconfig.json --force",
    "postinstall": "node build/postinstall.cjs",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:mac": "npm run build && electron-builder --mac",
    "build:win": "npm run build && electron-builder --win",
    "build:linux": "npm run build && electron-builder --linux",
    "build:dist": "npm run build && electron-builder",
    "lint": "eslint .",
    "sync:agent-templates": "node scripts/sync-agent-templates.js"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/headless": "^5.5.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.11.0",
    "better-sqlite3": "^12.10.0",
    "dompurify": "^3.4.8",
    "electron-log": "^5.4.4",
    "electron-updater": "^6.3.9",
    "marked": "^18.0.4",
    "node-pty": "^1.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.4",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.61.0",
    "vite": "^5.3.1",
    "vitest": "^1.6.0"
  }
}
